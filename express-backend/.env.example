# =================================================================
# FocusFlow WhatsApp Support Bot - Environment Variables
# =================================================================

# 1. Gemini AI API Key (from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."

# 2. WhatsApp Verify Token (Custom secret string defined by you, entered in Meta App Dashboard)
WHATSAPP_VERIFY_TOKEN="focusflow_secure_webhook_token_2026"

# 3. WhatsApp Cloud API Permanent System User Access Token
# Generated from Meta Business Manager > System Users (with whatsapp_business_messaging permission)
# NEVER expose this token to any frontend or client-side code!
WHATSAPP_TOKEN="EAAG..."

# 4. WhatsApp Phone Number ID (from Meta Developer Dashboard > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# 5. WhatsApp App Secret (from Meta Developer Dashboard > App Settings > Basic > App Secret)
# Used for cryptographic HMAC SHA-256 payload verification (X-Hub-Signature-256)
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# 6. Port for standalone Node server (Vercel automatically handles this via serverless functions)
PORT=3000
