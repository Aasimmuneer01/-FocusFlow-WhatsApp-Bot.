# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this backend/webhook is hosted (e.g. https://your-domain.vercel.app).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# WHATSAPP_VERIFY_TOKEN: A secret string you define, entered in the Meta App Dashboard > WhatsApp > Configuration > Webhook Verify Token.
WHATSAPP_VERIFY_TOKEN="focusflow_secure_webhook_token_2026"

# WHATSAPP_TOKEN: Meta Permanent System User Access Token (with whatsapp_business_messaging permission).
# Keep strictly secret on the server - never expose to frontend code.
WHATSAPP_TOKEN="EAAG..."

# WHATSAPP_PHONE_NUMBER_ID: Found in Meta Developer Dashboard > WhatsApp > API Setup > Phone number ID.
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# WHATSAPP_APP_SECRET: Found in Meta App Dashboard > App Settings > Basic > App Secret.
# Used for cryptographic HMAC SHA-256 signature verification (X-Hub-Signature-256).
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# PORT: Server port for standalone Express execution (defaults to 3000).
PORT=3000

